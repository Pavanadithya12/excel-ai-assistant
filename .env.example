# ==============================================================================
#  AI EXCEL ASSISTANT - CONFIGURATION & ENVIRONMENT VARIABLES
# ==============================================================================
#
# 🛠️ COMPLETE TECHNOLOGY STACK USED:
# ------------------------------------------------------------------------------
# 1. CORE LANGUAGE:
#    - Python 3.11+
#
# 2. BACKEND & WEB SERVER:
#    - FastAPI (v0.143+): Modern, high-performance async REST API framework
#    - Uvicorn (v0.54+): Production ASGI web server
#    - Starlette & Pydantic v2 (pydantic-settings): Data validation & settings management
#
# 3. RELATIONAL SQL DATABASE & ORM:
#    - SQLAlchemy (v2.1+): Relational ORM mapping Users, ExcelFiles, ChatSessions, History
#    - SQLite: Default embedded database (zero-setup local execution)
#    - PostgreSQL / MySQL: Production-ready alternative supported via DATABASE_URL
#
# 4. SPREADSHEET PROCESSING & COMPUTATION:
#    - Pandas (v3.0+): High-speed data analysis, aggregations, group-by, top-N metrics
#    - NumPy (v2.4+): Numerical computations and data type inference
#    - openpyxl (v3.1+): Reading/writing .xlsx, cell styling, Excel formula injection,
#      summary table generation, and embedding charts directly into Excel sheets
#
# 5. CHART VISUALIZATION & GRAPHICS:
#    - Matplotlib (v3.11+): Headless 'Agg' backend rendering Bar, Line, Pie, Scatter charts
#    - Seaborn (v0.13+): Modern statistical visual styling and color palettes
#
# 6. LARGE LANGUAGE MODEL (LLM) PROVIDERS:
#    - Google Gemini: Official google-genai SDK (v2.31+) with Gemini 2.5 Flash / 1.5 Flash
#    - OpenAI: Official openai SDK (v3.33+) with GPT-4o / GPT-4o-mini
#    - Built-in Smart Heuristic Engine: High-accuracy schema-grounded fallback
#      allowing full offline functionality without needing an active API key
#
# 7. AUTHENTICATION & SECURITY:
#    - bcrypt: Industry-standard salted password hashing
#    - python-jose: HS256 JWT (JSON Web Token) bearer authentication
#    - Email OTP Service: 6-digit numeric verification code for account activation
#
# 8. MULTI-SOURCE AI WEB RESEARCH:
#    - Requests & DuckDuckGo Knowledge API: Multi-source search & fact synthesis
#
# 9. FRONTEND USER INTERFACE:
#    - Single Page Application (SPA): Vanilla JavaScript, HTML5, Modern CSS
#    - Interactive Chat, Formula Copying, Schema Inspector, Chart Viewer, Enhanced Excel Download
#
# 10. AUTOMATED TESTING:
#    - Pytest (v9.1+) & HTTPX: 15 comprehensive unit and API integration tests
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PROJECT & SECURITY SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="AI Excel Assistant"
API_V1_STR="/api"
# Secret key used for signing JWT access tokens (change in production)
SECRET_KEY="super-secret-ai-excel-assistant-jwt-key-change-in-prod-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 2. SQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default: SQLite database located in workspace (zero setup required)
DATABASE_URL="sqlite:///./ai_excel.db"

# For PostgreSQL (e.g., Render PostgreSQL / Supabase / Neon):
# DATABASE_URL="postgresql://username:password@localhost:5432/ai_excel_db"

# For MySQL:
# DATABASE_URL="mysql+pymysql://username:password@localhost:3306/ai_excel_db"

# ------------------------------------------------------------------------------
# 3. LLM API KEYS & PROVIDER SELECTION
# ------------------------------------------------------------------------------
# Choose provider mode: 'auto' (checks Gemini, then OpenAI, then Fallback),
# or explicitly set 'gemini' or 'openai'.
LLM_PROVIDER="auto"

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com)
# Models used: gemini-2.5-flash / gemini-1.5-flash
GEMINI_API_KEY=""

# OpenAI API Key (Obtain from OpenAI Platform: https://platform.openai.com)
# Models used: gpt-4o / gpt-4o-mini
OPENAI_API_KEY=""

# NOTE: If no API key is set, the built-in Smart Heuristic Engine automatically
# interprets spreadsheet questions, creates formulas, runs Pandas analysis,
# and generates charts seamlessly!

# ------------------------------------------------------------------------------
# 4. EMAIL & OTP SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# When EMAIL_DEV_MODE=True, the 6-digit OTP code is logged directly to the server
# console and returned in registration responses for instant testing and verification.
EMAIL_DEV_MODE=True

# (Optional) Real SMTP Email delivery settings:
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL="noreply@aiexcelassistant.local"

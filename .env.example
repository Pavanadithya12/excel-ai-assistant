# ========================================================
# AI Excel Assistant - Environment Configuration
# ========================================================

# Project Settings
PROJECT_NAME="AI Excel Assistant"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: SQLite (zero-setup local execution)
DATABASE_URL="sqlite:///./ai_excel.db"
# Or PostgreSQL / MySQL:
# DATABASE_URL="postgresql://username:password@localhost:5432/ai_excel_db"
# DATABASE_URL="mysql+pymysql://username:password@localhost:3306/ai_excel_db"

# LLM Provider Configuration
# Choose: 'auto', 'gemini', or 'openai'
LLM_PROVIDER="auto"

# Google Gemini API Key (optional - smart engine works even without an API key)
GEMINI_API_KEY=""

# OpenAI API Key (optional)
OPENAI_API_KEY=""

# Email Service / OTP Configuration
# Set EMAIL_DEV_MODE=True to log OTP codes to console & API responses for instant testing
EMAIL_DEV_MODE=True

# Real SMTP Email Settings (optional for production delivery)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL="noreply@aiexcelassistant.local"

{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Excel AI Assistant (Uvicorn)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host", "127.0.0.1",
                "--port", "8000",
                "--reload"
            ],
            "jinja": true,
            "justMyCode": false,
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "envFile": "${workspaceFolder}\\.env",
            "cwd": "${workspaceFolder}"
        }
    ]
}
